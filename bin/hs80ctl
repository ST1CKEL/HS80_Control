#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
for library in \
    "$script_dir/../src" \
    "$script_dir/../lib/hs80-control" \
    "${HS80_CONTROL_LIBDIR:-}" \
    "$HOME/.local/lib/hs80-control" \
    "/usr/local/lib/hs80-control" \
    "/usr/lib/hs80-control"
do
    if [ -n "$library" ] && [ -d "$library/hs80_control" ]; then
        export PYTHONPATH="$library${PYTHONPATH:+:$PYTHONPATH}"
        exec /usr/bin/python3 -m hs80_control.cli "$@"
    fi
done

printf '%s\n' "hs80ctl: Python package hs80_control was not found" >&2
exit 1
