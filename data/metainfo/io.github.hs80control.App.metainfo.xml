<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.hs80control.App</id>
  <name>HS80 Control</name>
  <summary>Control Corsair HS80 hardware and spatial audio</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="io.github.hs80control">
    <name>HS80 Control contributors</name>
  </developer>
  <url type="homepage">https://github.com/ST1CKEL/HS80_Control</url>
  <url type="bugtracker">https://github.com/ST1CKEL/HS80_Control/issues</url>
  <description>
    <p>
      HS80 Control manages RGB zones, battery information, sleep timeout,
      sidetone and microphone gain for the Corsair HS80 RGB Wireless headset.
    </p>
    <p>
      It can also create a PipeWire 7.1 virtual sink and render it to stereo
      with a user-selected SOFA HRTF.
    </p>
  </description>
  <launchable type="desktop-id">io.github.hs80control.App.desktop</launchable>
  <provides>
    <binary>hs80-control</binary>
    <binary>hs80ctl</binary>
  </provides>
  <releases>
    <release version="0.1.1" date="2026-08-13">
      <description>
        <p>Fix hardware response matching and active headset discovery.</p>
      </description>
    </release>
    <release version="0.1.0" date="2026-08-10">
      <description>
        <p>Initial implementation for receiver 1b1c:0a6b.</p>
      </description>
    </release>
  </releases>
  <content_rating type="oars-1.1"/>
</component>
