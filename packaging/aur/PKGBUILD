# Maintainer: ST1CKEL <ST1CKEL@users.noreply.github.com>
pkgname=hs80-control
pkgver=0.9.0
pkgrel=1
pkgdesc="Native control app for the Corsair HS80 RGB Wireless headset: battery, RGB, sidetone, microphone, voice announcements and binaural 7.1"
arch=('any')
url="https://github.com/ST1CKEL/HS80_Control"
license=('GPL-3.0-or-later' 'CC0-1.0')
depends=(
  'python>=3.11'
  'python-dbus-next'
  'python-gobject'
  'gtk4'
  'libadwaita>=1.7'
  'hidapi'
  'alsa-utils'
  'pipewire'
  'wireplumber'
  'systemd'
)
optdepends=(
  'pipewire-audio: binaural 7.1 spatial audio (SOFA filter plugin)'
  'easyeffects: noise suppression and dynamics for the microphone'
  'gnome-shell-extension-appindicator: tray icon on GNOME'
)
backup=('etc/xdg/autostart/io.github.hs80control.App.desktop')
install=hs80-control.install
source=("$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('aec006d2fa29208757266ef16aea04a5c52f98a1b55cf3ecd19d558b89f49050')

check() {
  cd "$pkgname-$pkgver"
  HS80_CONTROL_LANGUAGE=de PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=src \
    python -m unittest discover -s tests
}

package() {
  cd "$pkgname-$pkgver"
  make install DESTDIR="$pkgdir" PREFIX=/usr
  install -Dm0644 LICENSE.CC0 "$pkgdir/usr/share/licenses/$pkgname/LICENSE.CC0"
}
